# Randevu formunun kullandığı SMTP bilgileri.
# Bu dosya örnektir; gerçek değerler `.env` dosyasına (yerel geliştirme) ve
# Vercel panelinde Settings → Environment Variables altına girilir.
# `.env` gitignore'da, asla commitlenmez.

# Gmail için: hesapta iki adımlı doğrulama açık olmalı ve buraya hesabın
# kendi şifresi değil, 16 haneli "uygulama şifresi" yazılır.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gonderen@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Randevu taleplerinin düşeceği kutu.
MAIL_TO=burmay@yahoo.com
