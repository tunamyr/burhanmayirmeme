---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { POSTS, CATEGORIES, POST_HREF } from '../data/posts';
---

<BaseLayout
  title="Bilgi Yazıları — Prof. Dr. Burhan Mayir"
  description="Muayenehanede en çok sorulan soruların yazılı halleri: tarama, meme kanseri cerrahisi, iyi huylu meme hastalıkları ve tedavi süreçleri üzerine bilgi yazıları."
  active="blog"
>
  <SiteNav active="blog" />

  <main id="icerik">
    <section class="hero">
      <div class="shell">
        <div class="hero__kicker">Bilgi yazıları</div>
        <h1 class="hero__title">Muayenehanede en çok sorulan soruların yazılı halleri</h1>
        <p class="hero__lede">
          Görüşme süresi her zaman her soruya yetmiyor. Bu yazılar, aklınıza sonradan gelenler için.
        </p>
      </div>
    </section>

    <section class="posts" data-blog>
      <div class="shell">
        <div class="filters" role="group" aria-label="Yazıları konuya göre süz">
          {
            CATEGORIES.map((c, i) => (
              <button
                type="button"
                class:list={['chip', { 'chip--on': i === 0 }]}
                data-filter={c}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {c}
              </button>
            ))
          }
        </div>

        <div class="cards">
          {
            POSTS.map((p, i) => (
              <a
                class:list={['card', { 'card--featured': i === 0 }]}
                href={POST_HREF(p)}
                data-cat={p.cat}
              >
                <div class="card__media">
                  <img
                    src={p.img}
                    alt={p.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <div class="card__body">
                  <div class="card__kicker">
                    <span class="card__flag">Öne çıkan</span>
                    <span class="card__rule" aria-hidden="true" />
                    <span class="card__tag">{p.tag}</span>
                  </div>
                  <h2 class="card__title">{p.title}</h2>
                  <p class="card__excerpt">{p.excerpt}</p>
                  <span class="card__meta">
                    <span class="card__read">{p.read}</span>
                    <span class="card__more"> · Yazıyı oku →</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <p class="count" data-count aria-live="polite">{POSTS.length} yazı gösteriliyor</p>
      </div>
    </section>

    <section class="cta">
      <div class="shell cta__box">
        <div>
          <div class="cta__title">Yanıtını bulamadığınız bir soru mu var?</div>
          <p class="cta__text">
            Sorunuzu görüşmede sormanız en doğrusu. Randevu talebinizi bırakırsanız sizi arayıp
            uygun bir saat belirleriz.
          </p>
        </div>
        <a class="cta__btn" href="/iletisim">Randevu talep et</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-blog]');
  if (wrap) {
    const buttons = [...wrap.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...wrap.querySelectorAll<HTMLElement>('[data-cat]')];
    const count = wrap.querySelector<HTMLElement>('[data-count]');

    const apply = (cat: string) => {
      const visible: HTMLElement[] = [];
      for (const card of cards) {
        const on = cat === 'Tümü' || card.dataset.cat === cat;
        card.hidden = !on;
        card.classList.remove('card--featured');
        if (on) visible.push(card);
      }
      // Tasarımdaki kural: süzülen listenin ilki öne çıkan karta dönüşür.
      visible[0]?.classList.add('card--featured');

      if (count) count.textContent = `${visible.length} yazı gösteriliyor`;

      for (const b of buttons) {
        const on = b.dataset.filter === cat;
        b.classList.toggle('chip--on', on);
        b.setAttribute('aria-pressed', String(on));
      }
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(b.dataset.filter ?? 'Tümü'));
    }
  }
</script>

<style>
  /* --- Hero --- */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 64px var(--page-pad) 68px;
  }
  .hero__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 48px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    max-width: 22em;
    text-wrap: pretty;
  }
  .hero__lede {
    font-size: 18.5px;
    line-height: 1.7;
    color: var(--text);
    margin: 0;
    max-width: 40em;
    text-wrap: pretty;
  }

  /* --- Süzgeç --- */
  .posts { padding: 64px var(--page-pad) 20px; }

  .filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .chip {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text-soft);
    padding: 11px 20px;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: var(--sans);
    transition: all var(--ease);
  }
  .chip:hover { border-color: var(--line-hover); color: var(--ink); }
  .chip--on {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  /* --- Kartlar --- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  /* .card display:flex olduğu için hidden'ı zorlamak gerekiyor. */
  .cards [hidden] { display: none !important; }

  .card {
    background: var(--bg);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    color: var(--ink);
    transition: background var(--ease), border-color var(--ease);
  }
  .card:hover { background: var(--surface); color: var(--ink); }

  .card__media { overflow: hidden; }
  .card__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .card__body {
    padding: 28px 30px 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card__kicker { display: flex; gap: 16px; align-items: center; }
  /* "Öne çıkan" rozeti ve ayraç yalnız öne çıkan kartta görünür. */
  .card__flag,
  .card__rule { display: none; }
  .card__tag {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.35;
    margin: 0;
    text-wrap: pretty;
  }
  .card__excerpt {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-soft);
    flex: 1;
  }
  .card__meta { font-size: 12.5px; color: var(--fainter); }
  .card__more { display: none; }

  /* --- Öne çıkan kart: aynı şablon, farklı yerleşim --- */
  .card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    background: var(--bg);
    margin-bottom: 16px;
  }
  .card--featured:hover { background: var(--bg); border-color: var(--line-hover); }

  .card--featured .card__body {
    order: 1;
    padding: 48px 52px;
    justify-content: center;
    gap: 0;
  }
  .card--featured .card__media { order: 2; min-height: 320px; }
  .card--featured .card__media img { aspect-ratio: auto; }

  .card--featured .card__kicker { margin-bottom: 20px; }
  .card--featured .card__flag {
    display: inline;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card--featured .card__rule {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--line-hover);
  }
  .card--featured .card__tag {
    font-size: 12.5px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--faint);
  }

  .card--featured .card__title {
    font-size: 34px;
    line-height: 1.28;
    letter-spacing: -0.01em;
    margin: 0 0 18px;
  }
  .card--featured .card__excerpt {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text);
    max-width: 34em;
    margin: 0 0 24px;
    flex: 0;
  }
  .card--featured .card__meta {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card--featured .card__more { display: inline; }

  .count {
    margin: 26px 0 0;
    font-size: 14px;
    color: var(--fainter);
  }

  /* --- Randevu bandı --- */
  .cta { padding: 70px var(--page-pad) 84px; }
  .cta__box {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 44px 48px;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 48px;
    align-items: center;
  }
  .cta__title {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.35;
    margin-bottom: 10px;
  }
  .cta__text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text);
    max-width: 40em;
  }
  .cta__btn {
    display: block;
    text-align: center;
    background: var(--ink);
    color: var(--bg);
    padding: 17px 30px;
    font-size: 13.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background var(--ease);
  }
  .cta__btn:hover { background: var(--accent); color: var(--bg); }

  /* --- Duyarlı davranış (tasarımda masaüstü vardı) --- */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
    .hero__title { font-size: 40px; }
  }
  @media (max-width: 820px) {
    .card--featured { grid-template-columns: 1fr; }
    .card--featured .card__body { order: 2; padding: 32px 30px 36px; }
    .card--featured .card__media { order: 1; min-height: 0; }
    .card--featured .card__media img { aspect-ratio: 16 / 10; }
    .card--featured .card__title { font-size: 27px; }
    .cta__box { grid-template-columns: 1fr; gap: 28px; padding: 34px 30px; }
  }
  @media (max-width: 620px) {
    .cards { grid-template-columns: 1fr; }
    .hero { padding-top: 44px; padding-bottom: 48px; }
    .hero__title { font-size: 31px; }
    .hero__lede { font-size: 17px; }
    .posts { padding-top: 44px; }
  }
</style>
