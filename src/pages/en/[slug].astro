---
import Topic from '../../components/pages/Topic.astro';
import { DICTS } from '../../i18n';

export function getStaticPaths() {
  return DICTS.en.topics.map((topic, index) => ({
    params: { slug: topic.slug },
    props: { index },
  }));
}

const { index } = Astro.props;
---

<Topic lang="en" index={index} />
