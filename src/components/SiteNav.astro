---
import { t, pageHref, topicHref, type Locale, type Alternate } from '../i18n';

interface Props {
  lang: Locale;
  /** 'home' | 'about' | 'blog' | 'contact' ya da bir konu anahtarı. */
  active?: string;
  /** Aynı sayfanın üç dildeki adresi. */
  alts: Alternate[];
}

const { lang, active = '', alts } = Astro.props;
const d = t(lang);

const TOPICS = d.topics.map((topic, i) => ({
  label: topic.navTitle,
  href: topicHref(lang, i),
  key: topic.key,
}));

/* Menü sırası: Ana Sayfa · Hakkımda · Hastalıklar · Blog · İletişim.
   Hastalıklar dropdown'ı ortada durduğu için liste ikiye bölünüyor. */
const LINKS_BEFORE = [
  { label: d.nav.home, href: pageHref(lang, 'home'), key: 'home' },
  { label: d.nav.about, href: pageHref(lang, 'about'), key: 'about' },
];

const LINKS_AFTER = [
  { label: d.nav.blog, href: pageHref(lang, 'blog'), key: 'blog' },
  { label: d.nav.contact, href: pageHref(lang, 'contact'), key: 'contact' },
];

const topicActive = TOPICS.some((x) => x.key === active);
const topicsHref = `${pageHref(lang, 'home')}#konular`;
const contactHref = pageHref(lang, 'contact');
---

<header class="nav">
  <div class="nav__bar">
    <a class="brand" href={pageHref(lang, 'home')}>
      <span class="brand__name">{d.brandName}</span>
      <span class="brand__kicker">{d.nav.kicker}</span>
    </a>

    <nav class="nav__links" aria-label={d.nav.menuLabel}>
      {
        LINKS_BEFORE.map((l) => (
          <a class="link" href={l.href} aria-current={l.key === active ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }

      <div class="drop">
        <a class="link drop__trigger" href={topicsHref} aria-current={topicActive ? 'true' : undefined}>
          {d.nav.topics} <span class="drop__caret" aria-hidden="true">▾</span>
        </a>
        <div class="drop__panel">
          {
            TOPICS.map((x) => (
              <a class="drop__item" href={x.href} aria-current={x.key === active ? 'page' : undefined}>
                {x.label}
              </a>
            ))
          }
        </div>
      </div>

      {
        LINKS_AFTER.map((l) => (
          <a class="link" href={l.href} aria-current={l.key === active ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }

      <span class="rule" aria-hidden="true"></span>

      <div class="langs">
        {
          alts.map((a) => (
            <a
              class:list={['lang', { 'lang--on': a.lang === lang }]}
              href={a.href}
              hreflang={a.htmlLang}
              lang={a.htmlLang}
              aria-current={a.lang === lang ? 'true' : undefined}
            >
              {a.short}
            </a>
          ))
        }
      </div>

      <a class="cta" href={contactHref}>{d.nav.cta}</a>
    </nav>

    <details class="mobile">
      <summary aria-label={d.nav.openMenu}><span aria-hidden="true">☰</span></summary>
      <div class="mobile__panel">
        {LINKS_BEFORE.map((l) => <a href={l.href}>{l.label}</a>)}
        <span class="mobile__head">{d.nav.topics}</span>
        {TOPICS.map((x) => <a class="mobile__topic" href={x.href}>{x.label}</a>)}
        {LINKS_AFTER.map((l) => <a href={l.href}>{l.label}</a>)}
        <span class="mobile__langs">
          {
            alts.map((a) => (
              <a
                class:list={['mobile__lang', { 'lang--on': a.lang === lang }]}
                href={a.href}
                hreflang={a.htmlLang}
                lang={a.htmlLang}
              >
                {a.short}
              </a>
            ))
          }
        </span>
        <a class="cta cta--block" href={contactHref}>{d.nav.cta}</a>
      </div>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-family: var(--sans);
  }
  .nav__bar {
    padding: 0 var(--page-pad);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: 76px;
    gap: 40px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--ink);
  }
  .brand:hover { color: var(--ink); }
  .brand__name {
    font-family: var(--serif);
    font-size: 20px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand__kicker {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .link {
    color: var(--text-soft);
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
    white-space: nowrap;
  }
  .link:hover { color: var(--accent); }
  .link[aria-current] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Tasarımdaki JS hover state'i yerine saf CSS: focus-within sayesinde
     klavyeyle de açılıyor. */
  .drop { position: relative; padding: 26px 0; }
  .drop__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .drop__caret { font-size: 10px; letter-spacing: 0; }

  .drop__panel {
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 320px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 0;
    display: grid;
    padding: 8px 0;
    box-shadow: 0 20px 40px -24px rgba(30, 26, 28, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--ease), transform var(--ease), visibility var(--ease);
  }
  .drop:hover .drop__panel,
  .drop:focus-within .drop__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .drop__item {
    padding: 13px 24px;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--ink);
  }
  .drop__item:hover { background: var(--surface); color: var(--accent); }
  .drop__item[aria-current] { color: var(--accent); background: var(--surface); }

  .rule { width: 1px; height: 20px; background: var(--line); }

  .langs { display: flex; gap: 10px; font-size: 12px; letter-spacing: 0.12em; }
  .lang { color: var(--fainter); }
  .lang:hover { color: var(--accent); }
  .lang--on { color: var(--ink); }

  .cta {
    background: var(--accent);
    color: var(--bg);
    padding: 12px 22px;
    font-size: 13px;
    letter-spacing: 0.08em;
    transition: background var(--ease);
    white-space: nowrap;
  }
  .cta:hover { background: var(--accent-dark); color: var(--bg); }

  /* --- Mobil: tasarımda yoktu, gerçek kullanım için eklendi --- */
  .mobile { display: none; }
  .mobile summary {
    list-style: none;
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    padding: 10px;
    color: var(--ink);
  }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 76px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 2px;
    padding: 12px var(--page-pad) 24px;
    box-shadow: 0 20px 40px -24px rgba(30, 26, 28, 0.3);
  }
  .mobile__panel a {
    padding: 13px 0;
    font-size: 15px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  /* Hastalıklar grubu artık listenin ortasında; başlık olmadan araya karışıyor. */
  .mobile__head {
    padding: 18px 0 7px;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fainter);
  }
  .mobile__topic { padding-left: 14px; }

  .mobile__langs {
    display: flex;
    gap: 18px;
    padding-top: 16px;
  }
  .mobile__lang {
    border-bottom: 0 !important;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--fainter) !important;
  }
  .mobile__lang.lang--on { color: var(--ink) !important; }

  .cta--block {
    margin-top: 14px;
    text-align: center;
    color: var(--bg);
    border-bottom: 0;
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .nav__links { display: none; }
    .mobile { display: block; justify-self: end; }
  }
</style>
