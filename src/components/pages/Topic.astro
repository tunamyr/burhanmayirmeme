---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../SiteNav.astro';
import SiteFooter from '../SiteFooter.astro';
import RandevuBand from '../RandevuBand.astro';
import { t, keyHref, pageHref, alternates, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  /** Konunun sözlükteki sırası. */
  index: number;
}

const { lang, index } = Astro.props;
const d = t(lang);
const topic = d.topics[index];
const alts = alternates('topic', index);
---

<BaseLayout
  lang={lang}
  title={`${topic.title} — ${d.doctorName}`}
  description={topic.meta}
  active={topic.key}
  ogImage={topic.img}
  alts={alts}
>
  <SiteNav lang={lang} active={topic.key} alts={alts} />

  <main id="icerik">
    <section class="hero">
      <div class="shell">
        <nav class="crumbs" aria-label={d.common.breadcrumbLabel}>
          <a href={pageHref(lang, 'home')}>{d.common.breadcrumbHome}</a>
          <span class="crumbs__sep" aria-hidden="true">/</span>
          <a href={`${pageHref(lang, 'home')}#konular`}>{d.common.breadcrumbTopics}</a>
          <span class="crumbs__sep" aria-hidden="true">/</span>
          <span class="crumbs__here" aria-current="page">{topic.crumb}</span>
        </nav>

        <div class="hero__grid">
          <div>
            <div class="hero__kicker">{d.common.topicNo} {topic.no}</div>
            <h1 class="hero__title">{topic.title}</h1>
            <p class="hero__lede">{topic.lede}</p>
          </div>
          <img class="hero__img" src={topic.img} alt={topic.imgAlt} width="1200" height="900" />
        </div>
      </div>
    </section>

    <section class="body">
      <div class="shell body__grid">
        <article class="article prose">
          {
            topic.sections.map((s) => (
              <section class="sec">
                <h2 class="sec__title">{s.h2}</h2>
                {s.blocks.map((b) =>
                  b.kind === 'p' ? (
                    <p>{b.text}</p>
                  ) : b.kind === 'ul' ? (
                    <ul class="list">
                      {b.items.map((i) => (
                        <li>
                          {i.lead && <strong>{i.lead}</strong>}
                          {i.lead ? ` ${i.text}` : i.text}
                        </li>
                      ))}
                    </ul>
                  ) : b.kind === 'cards' ? (
                    <div class="cards">
                      {b.items.map((i) => (
                        <div class="cards__item">
                          <div class="cards__k">{i.k}</div>
                          <p class="cards__v">{i.v}</p>
                        </div>
                      ))}
                    </div>
                  ) : b.kind === 'steps' ? (
                    <div class="steps">
                      {b.items.map((i) => (
                        <div class="steps__row">
                          <span class="steps__k">{i.k}</span>
                          <p class="steps__v">{i.v}</p>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="qa">
                      {b.items.map((i) => (
                        <div class="qa__row">
                          <div class="qa__q">{i.q}</div>
                          <p class="qa__a">{i.a}</p>
                        </div>
                      ))}
                    </div>
                  )
                )}
              </section>
            ))
          }
        </article>

        <aside class="side">
          <div class="facts">
            <div class="facts__head">{d.common.quickFacts}</div>
            <div class="facts__list">
              {
                topic.quickFacts.map((f) => (
                  <div class="facts__item">
                    <strong>{f.label}</strong>
                    {f.value}
                  </div>
                ))
              }
            </div>
          </div>

          <div class="ask">
            <div class="ask__title">{topic.ctaBox.title}</div>
            <p class="ask__text">{topic.ctaBox.text}</p>
            <a class="ask__cta" href={pageHref(lang, 'contact')}>{d.common.appointmentCta}</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="related">
      <div class="shell">
        <div class="related__head">{d.common.relatedTopics}</div>
        <div class="related__grid">
          {
            topic.related.map((r) => (
              <a class="related__card" href={keyHref(lang, r.key)}>
                <span class="related__title">{r.title}</span>
                <span class="related__text">{r.text}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <RandevuBand lang={lang} title={topic.band.title} text={topic.band.text} />
  <SiteFooter lang={lang} alts={alts} />
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 56px var(--page-pad) 64px;
  }

  .crumbs {
    font-size: 12.5px;
    color: var(--faint);
    margin-bottom: 32px;
  }
  .crumbs a {
    color: var(--faint);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs__sep {
    padding: 0 8px;
  }
  .crumbs__here {
    color: var(--ink);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: end;
  }
  .hero__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 22px;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 50px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    text-wrap: pretty;
  }
  .hero__lede {
    font-size: 19px;
    line-height: 1.68;
    color: var(--text);
    margin: 0;
    max-width: 34em;
    text-wrap: pretty;
  }
  .hero__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* --- Gövde --- */
  .body {
    padding: 76px var(--page-pad) 84px;
  }
  .body__grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 72px;
    align-items: start;
  }
  .article {
    max-width: 40em;
  }

  .sec + .sec {
    margin-top: 46px;
  }
  .sec__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.3;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }

  .list {
    margin: 0 0 30px;
    padding: 0 0 0 22px;
    display: grid;
    gap: 12px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-strong);
  }
  .list strong {
    font-weight: 600;
  }

  .cards {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin: 0 0 30px;
  }
  .cards__item {
    background: var(--bg);
    padding: 26px 28px;
  }
  .cards__k {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .cards__v {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .steps {
    display: grid;
    margin: 0 0 30px;
    border-top: 1px solid var(--line);
  }
  .steps__row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 22px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps__k {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
    padding-top: 3px;
  }
  .steps__v {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .qa {
    display: grid;
    border-top: 1px solid var(--line);
    margin: 0 0 30px;
  }
  .qa__row {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .qa__q {
    font-size: 17.5px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .qa__a {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  /* Blok sonrası son paragrafın alt boşluğu bloktan geliyor. */
  .sec > :last-child {
    margin-bottom: 0;
  }

  /* --- Kenar sütunu --- */
  .side {
    position: sticky;
    top: 108px;
    display: grid;
    gap: 24px;
  }

  .facts {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 30px 30px 34px;
  }
  .facts__head {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .facts__list {
    display: grid;
    gap: 16px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-strong);
  }
  .facts__item strong {
    font-weight: 600;
    display: block;
    margin-bottom: 3px;
  }

  .ask {
    background: var(--dark-bg);
    color: var(--dark-soft);
    padding: 30px;
  }
  .ask__title {
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.35;
    color: var(--dark-ink);
    margin-bottom: 14px;
  }
  .ask__text {
    margin: 0 0 22px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--dark-text);
  }
  .ask__cta {
    display: block;
    text-align: center;
    background: var(--accent);
    color: var(--dark-ink);
    padding: 14px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background var(--ease);
  }
  .ask__cta:hover {
    background: var(--accent-light);
    color: var(--dark-ink);
  }

  /* --- İlgili konular --- */
  .related {
    border-top: 1px solid var(--line);
    padding: 64px var(--page-pad);
  }
  .related__head {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 28px;
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .related__card {
    background: var(--bg);
    padding: 30px 30px 34px;
    display: grid;
    gap: 10px;
    color: var(--ink);
    transition: background var(--ease);
  }
  .related__card:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .related__title {
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.35;
  }
  .related__text {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  /* --- Dar ekranlar --- */
  @media (max-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: start;
    }
    .hero__title {
      font-size: 40px;
    }
    .body__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .side {
      position: static;
    }
    .related__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero__title {
      font-size: 33px;
    }
    .hero__lede {
      font-size: 17px;
    }
    .sec__title {
      font-size: 25px;
    }
    .steps__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
