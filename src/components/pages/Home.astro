---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../SiteNav.astro';
import SiteFooter from '../SiteFooter.astro';
import RandevuFormu from '../RandevuFormu.astro';
import { SITE } from '../../data/site';
import { t, pageHref, topicHref, alternates, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const alts = alternates('home');
const blogHref = pageHref(lang, 'blog');
const oneCikanlar = d.blog.posts.slice(0, 3);
---

<BaseLayout
  lang={lang}
  title={d.home.title}
  description={d.home.description}
  active="home"
  alts={alts}
>
  <SiteNav lang={lang} active="home" alts={alts} />

  <main id="icerik">
    <!-- Giriş -->
    <section class="hero">
      <div class="hero__text">
        <div class="hero__kicker">{d.home.kicker}</div>
        <h1 class="hero__title">
          {d.home.h1.pre}<i>{d.home.h1.em1}</i>{d.home.h1.mid}<i>{d.home.h1.em2}</i>{d.home.h1.post}
        </h1>
        <p class="hero__lede">{d.home.lede}</p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={pageHref(lang, 'contact')}>{d.common.appointmentCta}</a>
          <a class="btn btn--ghost" href="#konular">{d.home.topicsButton}</a>
        </div>
      </div>

      <div class="hero__aside">
        <img
          class="hero__img"
          src="/img/portre-kapi.png"
          alt={d.home.heroAlt}
          width="768"
          height="1024"
          fetchpriority="high"
        />
        <div class="stats">
          {
            SITE.stats.map((n, i) => (
              <div>
                <div class="stats__n">{n}</div>
                <div class="stats__l">{d.common.statLabels[i]}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Konular -->
    <section id="konular" class="topics">
      <div class="topics__head">
        <h2 class="h2">{d.home.topicsTitle}</h2>
        <p class="topics__intro">{d.home.topicsIntro}</p>
      </div>

      <div class="topics__grid" data-acc>
        <div class="acc">
          {
            d.topics.map((x, i) => (
              <button
                type="button"
                class="row"
                data-row={i}
                data-when={x.indexWhen}
                data-href={topicHref(lang, i)}
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`konu-govde-${i}`}
              >
                <span class="row__no">{x.no}</span>
                <span class="row__main">
                  <span class="row__title">{x.navTitle}</span>
                  <span class="row__body" id={`konu-govde-${i}`}>
                    {x.indexBody}
                  </span>
                </span>
              </button>
            ))
          }
        </div>

        <div class="panel">
          <div class="panel__media">
            {
              d.topics.map((x, i) => (
                <div
                  class="panel__pic"
                  role="img"
                  aria-label={x.imgAlt}
                  data-pic={i}
                  data-on={i === 0 ? '' : undefined}
                  data-bg={x.img}
                  style={i === 0 ? `background-image: url(${x.img})` : undefined}
                />
              ))
            }
          </div>
          <div class="panel__box">
            <div class="panel__kicker">{d.common.whenToApply}</div>
            <p class="panel__text" data-panel-when>{d.topics[0].indexWhen}</p>
            <a class="panel__link" href={topicHref(lang, 0)} data-panel-read>
              {d.common.readTopic}
            </a>
          </div>
        </div>
      </div>

      {/* JS varsa akordeon kapalı başlar; yoksa beş konu da açık kalır. */}
      <script is:inline>
        document.currentScript.previousElementSibling.setAttribute('data-enhanced', '');
      </script>
    </section>

    <!-- Hakkımda -->
    <section class="about">
      <div class="about__left">
        <div class="about__frame">
          <img
            src="/img/portre-masa.png"
            alt={d.home.aboutAlt}
            width="1024"
            height="1024"
            loading="lazy"
          />
        </div>
        <div class="creds">
          {
            d.home.creds.map((c) => (
              <div class="creds__item">
                <div class="creds__k">{c.k}</div>
                <div class="creds__v">{c.v}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="about__right">
        <div class="about__kicker">{d.home.aboutKicker}</div>
        <h2 class="about__title">{d.doctorName}</h2>
        <div class="about__text">
          {d.home.aboutParagraphs.map((p) => <p>{p}</p>)}
        </div>
        <a class="about__link" href={pageHref(lang, 'about')}>{d.home.aboutLink}</a>
      </div>
    </section>

    <!-- Bilgi yazıları -->
    <section class="posts">
      <div class="posts__head">
        <h2 class="h2">{d.home.postsTitle}</h2>
        <a class="posts__all" href={blogHref}>{d.home.postsAll}</a>
      </div>
      <div class="posts__grid">
        {
          oneCikanlar.map((p) => (
            <a class="post" href={`${blogHref}/${p.slug}`}>
              <span class="post__tag">{p.tag}</span>
              <h3 class="post__title">{p.title}</h3>
              <p class="post__excerpt">{p.short || p.excerpt}</p>
              <span class="post__read">{p.read}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Randevu -->
    <section class="appt">
      <div class="appt__box">
        <div>
          <div class="appt__kicker">{d.home.apptKicker}</div>
          <h2 class="appt__title">{d.home.apptTitle}</h2>
          <p class="appt__text">{d.home.apptText}</p>

          <iframe
            class="appt__map"
            src={SITE.mapsEmbed}
            title={d.common.mapTitle}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>

          <div class="appt__info">
            <div>
              <div class="appt__label">{d.common.phoneLabel}</div>
              <a class="appt__tel" href={SITE.phoneHref}>{SITE.phoneLabel}</a>
            </div>
            <div>
              <div class="appt__label">{d.common.officeLabel}</div>
              <address class="appt__addr">
                {SITE.addressLines.map((l) => <>{l}<br /></>)}
                <span class="appt__near">{d.common.addressNote}</span><br />
                <a class="appt__maps" href={SITE.mapsUrl}>{d.common.directions}</a>
              </address>
            </div>
          </div>
        </div>

        <RandevuFormu lang={lang} />
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} alts={alts} />
</BaseLayout>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-acc]');
  if (wrap) {
    const rows = [...wrap.querySelectorAll<HTMLButtonElement>('[data-row]')];
    const pics = [...wrap.querySelectorAll<HTMLElement>('[data-pic]')];
    const when = wrap.querySelector<HTMLElement>('[data-panel-when]');
    const read = wrap.querySelector<HTMLAnchorElement>('[data-panel-read]');

    /** Görseli ilk ihtiyaç duyulduğunda bağlar; ana sayfa beş fotoğrafla açılmasın diye. */
    const load = (p: HTMLElement) => {
      if (!p.style.backgroundImage && p.dataset.bg) {
        p.style.backgroundImage = `url(${p.dataset.bg})`;
      }
    };

    const pick = (row: HTMLButtonElement, i: number) => {
      rows.forEach((r) => r.setAttribute('aria-expanded', String(r === row)));
      load(pics[i]);
      pics.forEach((p, n) => p.toggleAttribute('data-on', n === i));
      if (when) when.textContent = row.dataset.when ?? '';
      if (read && row.dataset.href) read.href = row.dataset.href;
    };

    rows.forEach((r, i) => r.addEventListener('click', () => pick(r, i)));

    // Sayfa yerleştikten sonra kalanları sessizce indir: tıklayınca beklenmesin.
    const preload = () => pics.forEach(load);
    if ('requestIdleCallback' in window) requestIdleCallback(preload, { timeout: 4000 });
    else window.addEventListener('load', () => setTimeout(preload, 1200));
  }
</script>

<style>
  .h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* --- Giriş --- */
  .hero {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
  }
  .hero__text {
    padding: 92px 68px 84px var(--page-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--line);
  }
  .hero__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 34px;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 58px;
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin: 0 0 30px;
    max-width: 17em;
    text-wrap: pretty;
  }
  .hero__title i {
    color: var(--accent);
  }
  .hero__lede {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 44px;
    max-width: 32em;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
  }
  .btn {
    padding: 17px 34px;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background var(--ease);
  }
  .btn--solid {
    background: var(--ink);
    color: var(--bg);
  }
  .btn--solid:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .btn--ghost {
    border: 1px solid var(--ink);
    border-left: 0;
    padding: 17px 30px;
    color: var(--ink);
  }
  .btn--ghost:hover {
    background: var(--hover-tint);
    color: var(--ink);
  }

  .hero__aside {
    padding: 92px var(--page-pad) 88px 68px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
  }
  .hero__img {
    width: 100%;
    max-width: 480px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
  }
  .stats {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .stats__n {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1;
    color: var(--accent);
  }
  .stats__l {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 9px;
  }

  /* --- Konular --- */
  .topics {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 84px var(--page-pad);
  }
  .topics__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 48px;
  }
  .topics__intro {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text);
  }
  .topics__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: start;
  }

  .acc {
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 24px;
    width: 100%;
    text-align: left;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    cursor: pointer;
    padding: 26px 24px 26px 4px;
    color: var(--ink);
    font: inherit;
    transition: background var(--ease);
  }
  .row[aria-expanded='true'] {
    background: var(--bg);
  }
  .row__no {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--fainter);
    padding-top: 7px;
  }
  .row__main {
    display: grid;
    gap: 10px;
  }
  .row__title {
    font-family: var(--serif);
    font-size: 25px;
    line-height: 1.28;
    letter-spacing: -0.01em;
  }
  .row__body {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  /* JS yoksa hepsi açık kalır; data-enhanced ancak script çalıştıysa gelir. */
  [data-enhanced] .row__body {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.35s ease, opacity 0.25s ease;
  }
  [data-enhanced] .row[aria-expanded='true'] .row__body {
    max-height: 200px;
    opacity: 1;
  }

  .panel {
    position: sticky;
    top: 108px;
  }
  .panel__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--placeholder);
  }
  .panel__pic {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .panel__pic[data-on] {
    opacity: 1;
  }
  .panel__box {
    background: var(--bg);
    padding: 30px 32px 34px;
    border: 1px solid var(--line);
    border-top: 0;
  }
  .panel__kicker {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .panel__text {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }
  .panel__link {
    display: inline-block;
    border-bottom: 1px solid var(--line-hover);
    padding-bottom: 3px;
    font-size: 14.5px;
    color: var(--ink);
    transition: border-color var(--ease);
  }
  .panel__link:hover {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  /* --- Hakkımda şeridi --- */
  .about {
    background: var(--dark-bg);
    color: var(--dark-soft);
    padding: 88px var(--page-pad);
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: start;
  }
  .about__left {
    display: grid;
    gap: 34px;
    align-content: start;
  }
  .about__frame {
    background: var(--dark-surface);
    overflow: hidden;
  }
  .about__frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .creds {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--dark-hair);
  }
  .creds__item {
    background: var(--dark-bg);
    padding: 22px 20px;
  }
  .creds__k {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 10px;
  }
  .creds__v {
    font-size: 16.5px;
    line-height: 1.45;
    color: var(--dark-ink);
  }

  .about__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dark-kicker);
    margin-bottom: 24px;
  }
  .about__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 42px;
    line-height: 1.22;
    margin: 0 0 30px;
    color: var(--dark-ink);
    letter-spacing: -0.01em;
  }
  .about__text {
    display: grid;
    gap: 20px;
    margin-bottom: 40px;
  }
  .about__text p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--dark-text);
    margin: 0;
  }
  .about__link {
    display: inline-block;
    border-bottom: 1px solid var(--dark-line);
    padding-bottom: 4px;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dark-soft);
    transition: border-color var(--ease);
  }
  .about__link:hover {
    border-bottom-color: var(--dark-kicker);
    color: var(--dark-soft);
  }

  /* --- Bilgi yazıları --- */
  .posts {
    padding: 84px var(--page-pad);
  }
  .posts__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 44px;
  }
  .posts__all {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line-hover);
    padding-bottom: 4px;
    color: var(--ink);
    transition: border-color var(--ease);
  }
  .posts__all:hover {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }
  .posts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .post {
    background: var(--bg);
    padding: 34px 34px 38px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
    transition: background var(--ease);
  }
  .post:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .post__tag {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .post__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.35;
    margin: 0;
    text-wrap: pretty;
  }
  .post__excerpt {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .post__read {
    font-size: 12.5px;
    color: var(--fainter);
    margin-top: 4px;
  }

  /* --- Randevu --- */
  .appt {
    padding: 0 var(--page-pad) 84px;
  }
  .appt__box {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: start;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 52px 48px;
  }
  .appt__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 22px;
  }
  .appt__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.24;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }
  .appt__text {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 32px;
    max-width: 34em;
  }
  .appt__map {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    display: block;
    margin-bottom: 26px;
    filter: grayscale(0.35);
  }
  .appt__info {
    display: grid;
    gap: 18px;
    border-top: 1px solid var(--rule);
    padding-top: 24px;
  }
  .appt__label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 7px;
  }
  .appt__tel {
    font-family: var(--serif);
    font-size: 22px;
    color: var(--ink);
  }
  .appt__tel:hover {
    color: var(--accent);
  }
  .appt__addr {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
    font-style: normal;
  }
  .appt__near {
    font-size: 14.5px;
    color: var(--faint);
  }
  .appt__maps {
    border-bottom: 1px solid var(--line-hover);
    padding-bottom: 2px;
  }

  /* --- Dar ekranlar --- */
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__text {
      padding: 64px var(--page-pad) 48px;
      border-right: 0;
    }
    .hero__aside {
      padding: 0 var(--page-pad) 64px;
    }
    .hero__img {
      max-width: none;
    }
    .topics__head,
    .topics__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .panel {
      position: static;
    }
    .about {
      grid-template-columns: 1fr;
      gap: 44px;
      padding: 64px var(--page-pad);
    }
    .posts__grid {
      grid-template-columns: 1fr;
    }
    .appt__box {
      grid-template-columns: 1fr;
      padding: 36px 28px 40px;
    }
  }

  @media (max-width: 620px) {
    .hero__title {
      font-size: 38px;
    }
    .hero__lede {
      font-size: 17px;
    }
    .hero__actions {
      display: grid;
      gap: 0;
    }
    .btn {
      text-align: center;
    }
    .btn--ghost {
      border-left: 1px solid var(--ink);
      border-top: 0;
    }
    .h2,
    .about__title,
    .appt__title {
      font-size: 30px;
    }
    .stats {
      gap: 16px;
    }
    .stats__n {
      font-size: 24px;
    }
    .stats__l {
      font-size: 11px;
    }
    .appt__box {
      padding: 28px 20px 32px;
    }
  }
</style>
