---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../SiteNav.astro';
import SiteFooter from '../SiteFooter.astro';
import { t, pageHref, alternates, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const alts = alternates('blog');
const blogHref = pageHref(lang, 'blog');
---

<BaseLayout
  lang={lang}
  title={d.blog.title}
  description={d.blog.description}
  active="blog"
  alts={alts}
>
  <SiteNav lang={lang} active="blog" alts={alts} />

  <main id="icerik">
    <section class="hero">
      <div class="shell">
        <h1 class="hero__title">{d.blog.h1}</h1>
        <p class="hero__lede">{d.blog.lede}</p>
      </div>
    </section>

    <section class="posts">
      <div class="shell">
        <div class="cards">
          {
            d.blog.posts.map((p, i) => (
              <a class="card" href={`${blogHref}/${p.slug}`}>
                <div class="card__media">
                  <img
                    src={p.img}
                    alt={p.alt}
                    width="1024"
                    height="640"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <div class="card__body">
                  <div class="card__kicker">
                    <span class="card__tag">{p.tag}</span>
                  </div>
                  <h2 class="card__title">{p.title}</h2>
                  <p class="card__excerpt">{p.excerpt}</p>
                  <span class="card__meta">
                    <span class="card__read">{p.read}</span>
                    <span class="card__more">{d.blog.readMore}</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="shell cta__box">
        <div>
          <div class="cta__title">{d.blog.ctaTitle}</div>
          <p class="cta__text">{d.blog.ctaText}</p>
        </div>
        <a class="cta__btn" href={pageHref(lang, 'contact')}>{d.blog.ctaButton}</a>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} alts={alts} />
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 64px var(--page-pad) 68px;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 48px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    max-width: 22em;
    text-wrap: pretty;
  }
  .hero__lede {
    font-size: 18.5px;
    line-height: 1.7;
    color: var(--text);
    margin: 0;
    max-width: 40em;
    text-wrap: pretty;
  }

  /* --- Kart listesi --- */
  .posts { padding: 64px var(--page-pad) 20px; }


  /* --- Kartlar --- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .card {
    background: var(--bg);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    color: var(--ink);
    transition: background var(--ease), border-color var(--ease);
  }
  .card:hover { background: var(--surface); color: var(--ink); }

  .card__media { overflow: hidden; }
  .card__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .card__body {
    padding: 28px 30px 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card__kicker { display: flex; gap: 16px; align-items: center; }
  .card__tag {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.35;
    margin: 0;
    text-wrap: pretty;
  }
  .card__excerpt {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-soft);
    flex: 1;
  }
  .card__meta { font-size: 12.5px; color: var(--fainter); }
  .card__more { display: none; }

  /* --- Randevu bandı --- */
  .cta { padding: 70px var(--page-pad) 84px; }
  .cta__box {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 44px 48px;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 48px;
    align-items: center;
  }
  .cta__title {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.35;
    margin-bottom: 10px;
  }
  .cta__text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text);
    max-width: 40em;
  }
  .cta__btn {
    display: block;
    text-align: center;
    background: var(--ink);
    color: var(--bg);
    padding: 17px 30px;
    font-size: 13.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background var(--ease);
  }
  .cta__btn:hover { background: var(--accent); color: var(--bg); }

  /* --- Duyarlı davranış (tasarımda masaüstü vardı) --- */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
    .hero__title { font-size: 40px; }
  }
  @media (max-width: 820px) {
    .cta__box { grid-template-columns: 1fr; gap: 28px; padding: 34px 30px; }
  }
  @media (max-width: 620px) {
    .cards { grid-template-columns: 1fr; }
    .hero { padding-top: 44px; padding-bottom: 48px; }
    .hero__title { font-size: 31px; }
    .hero__lede { font-size: 17px; }
    .posts { padding-top: 44px; }
  }
</style>
