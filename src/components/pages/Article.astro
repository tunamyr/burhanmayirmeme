---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../SiteNav.astro';
import SiteFooter from '../SiteFooter.astro';
import RandevuBand from '../RandevuBand.astro';
import { t, pageHref, alternates, LOCALES, DICTS, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  /** Yazının sözlükteki sırası — diller arası eşleşme bununla kuruluyor. */
  index: number;
}

const { lang, index } = Astro.props;
const d = t(lang);
const post = d.blog.posts[index];
const blogHref = pageHref(lang, 'blog');

/** Aynı yazının üç dildeki adresi. */
const alts = LOCALES.map((l) => ({
  lang: l,
  label: DICTS[l].label,
  short: DICTS[l].short,
  htmlLang: DICTS[l].htmlLang,
  href: `${pageHref(l, 'blog')}/${DICTS[l].blog.posts[index].slug}`,
}));

const sections = post.sections ?? [];

/** Liste sırasına göre komşu yazılar; ilk ve son yazıda biri boş kalır. */
const prev = index > 0 ? d.blog.posts[index - 1] : null;
const next = index < d.blog.posts.length - 1 ? d.blog.posts[index + 1] : null;
---

<BaseLayout
  lang={lang}
  title={`${post.title} — ${d.doctorName}`}
  description={post.excerpt}
  active="blog"
  ogImage={post.img}
  alts={alts}
>
  <SiteNav lang={lang} active="blog" alts={alts} />

  <main id="icerik">
    <article>
      <section class="hero">
        <div class="shell">
          <nav class="crumbs" aria-label={d.common.breadcrumbLabel}>
            <a href={pageHref(lang, 'home')}>{d.common.breadcrumbHome}</a>
            <span class="crumbs__sep" aria-hidden="true">/</span>
            <a href={blogHref}>{d.nav.blog}</a>
          </nav>

          <div class="hero__meta">
            <span class="hero__tag">{post.tag}</span>
            <span class="hero__rule" aria-hidden="true"></span>
            <span class="hero__read">{post.read}</span>
          </div>

          <h1 class="hero__title">{post.title}</h1>
          <p class="hero__lede">{post.excerpt}</p>
        </div>
      </section>

      <div class="shell media">
        <img src={post.img} alt={post.alt} width="1024" height="640" fetchpriority="high" />
      </div>

      <section class="body">
        <div class="shell">
          <div class="prose article">
            {
              sections.map((s) => (
                <section class="sec">
                  <h2 class="sec__title">{s.h2}</h2>
                  {s.blocks.map((b) =>
                    b.kind === 'p' ? (
                      <p>{b.text}</p>
                    ) : b.kind === 'ul' ? (
                      <ul class="list">
                        {b.items.map((i) => (
                          <li>
                            {i.lead && <strong>{i.lead}</strong>}
                            {i.lead ? ` ${i.text}` : i.text}
                          </li>
                        ))}
                      </ul>
                    ) : b.kind === 'cards' ? (
                      <div class="cards">
                        {b.items.map((i) => (
                          <div class="cards__item">
                            <div class="cards__k">{i.k}</div>
                            <p class="cards__v">{i.v}</p>
                          </div>
                        ))}
                      </div>
                    ) : b.kind === 'steps' ? (
                      <div class="steps">
                        {b.items.map((i) => (
                          <div class="steps__row">
                            <span class="steps__k">{i.k}</span>
                            <p class="steps__v">{i.v}</p>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="qa">
                        {b.items.map((i) => (
                          <div class="qa__row">
                            <div class="qa__q">{i.q}</div>
                            <p class="qa__a">{i.a}</p>
                          </div>
                        ))}
                      </div>
                    )
                  )}
                </section>
              ))
            }

            <p class="note">{d.footer.note}</p>
            <a class="back" href={blogHref}>{d.blog.backToBlog}</a>
          </div>
        </div>
      </section>
    </article>

    {
      (prev || next) && (
        <section class="more">
          <div class="shell">
            <div class="more__head">{d.blog.alsoRead}</div>
            <nav class="more__grid" aria-label={d.blog.alsoRead}>
              {prev && (
                <a class="more__card" href={`${blogHref}/${prev.slug}`} rel="prev">
                  <span class="more__dir">← {d.blog.prevPost}</span>
                  <span class="more__title">{prev.title}</span>
                  <span class="more__text">{prev.short || prev.excerpt}</span>
                </a>
              )}
              {next && (
                <a class="more__card more__card--next" href={`${blogHref}/${next.slug}`} rel="next">
                  <span class="more__dir">{d.blog.nextPost} →</span>
                  <span class="more__title">{next.title}</span>
                  <span class="more__text">{next.short || next.excerpt}</span>
                </a>
              )}
            </nav>
          </div>
        </section>
      )
    }
  </main>

  <RandevuBand lang={lang} />
  <SiteFooter lang={lang} alts={alts} />
</BaseLayout>

<style>
  /* --- Başlık --- */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 56px var(--page-pad) 60px;
  }
  .crumbs {
    font-size: 12.5px;
    color: var(--faint);
    margin-bottom: 30px;
  }
  .crumbs a { color: var(--faint); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs__sep { padding: 0 8px; }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .hero__tag {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__rule {
    width: 24px;
    height: 1px;
    background: var(--line-hover);
  }
  .hero__read {
    font-size: 12.5px;
    color: var(--faint);
  }

  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 44px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    max-width: 20em;
    text-wrap: pretty;
  }
  .hero__lede {
    font-size: 19px;
    line-height: 1.68;
    color: var(--text);
    margin: 0;
    max-width: 40em;
    text-wrap: pretty;
  }

  /* --- Görsel --- */
  .media {
    padding: 0 var(--page-pad);
    margin-top: -1px;
  }
  .media img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  /* --- Gövde --- */
  .body { padding: 64px var(--page-pad) 80px; }
  .article { max-width: 40em; }

  .sec + .sec { margin-top: 44px; }
  .sec__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.3;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }
  .sec > :last-child { margin-bottom: 0; }

  .list {
    margin: 0 0 28px;
    padding: 0 0 0 22px;
    display: grid;
    gap: 12px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-strong);
  }
  .list strong { font-weight: 600; }

  .cards {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin: 0 0 28px;
  }
  .cards__item { background: var(--bg); padding: 24px 26px; }
  .cards__k {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .cards__v {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .steps {
    display: grid;
    margin: 0 0 28px;
    border-top: 1px solid var(--line);
  }
  .steps__row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 22px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps__k {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
    padding-top: 3px;
  }
  .steps__v {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .qa {
    display: grid;
    border-top: 1px solid var(--line);
    margin: 0 0 28px;
  }
  .qa__row { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .qa__q { font-size: 17.5px; font-weight: 600; margin-bottom: 8px; }
  .qa__a {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .note {
    margin: 48px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
  }
  .back {
    display: inline-block;
    margin-top: 26px;
    font-size: 13.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line-hover);
    padding-bottom: 4px;
    color: var(--ink);
    transition: border-color var(--ease);
  }
  .back:hover { border-bottom-color: var(--accent); color: var(--ink); }

  /* --- Önceki / sonraki yazı --- */
  .more {
    border-top: 1px solid var(--line);
    padding: 56px var(--page-pad) 64px;
  }
  .more__head {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 26px;
  }
  .more__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .more__card {
    background: var(--bg);
    padding: 28px 30px 32px;
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--ink);
    transition: background var(--ease);
  }
  .more__card:hover { background: var(--surface); color: var(--ink); }
  /* Sonraki her zaman sağ sütunda: tek kart kaldığında da yeri şaşmasın. */
  .more__card--next {
    grid-column: 2;
    text-align: right;
  }
  .more__dir {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .more__title {
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .more__text {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-soft);
    /* İki satırda kes: kartlar aynı yükseklikte kalsın. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .hero__title { font-size: 34px; }
    .more__grid { grid-template-columns: 1fr; }
    .more__card--next { grid-column: 1; text-align: left; }
    .hero__lede { font-size: 17.5px; }
    .media img { aspect-ratio: 16 / 9; }
    .body { padding-top: 48px; }
  }
  @media (max-width: 620px) {
    .hero__title { font-size: 28px; }
    .sec__title { font-size: 24px; }
    .steps__row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
