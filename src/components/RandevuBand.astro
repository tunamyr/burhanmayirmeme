---
import { SITE } from '../data/site';
import { t, pageHref, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title?: string;
  text?: string;
}

const { lang, title, text } = Astro.props;
const d = t(lang);
---

<section class="band">
  <div class="band__grid">
    <div>
      <div class="band__kicker">{d.band.kicker}</div>
      <h2 class="band__title">{title ?? d.band.title}</h2>
      <p class="band__text">{text ?? d.band.text}</p>
    </div>
    <div class="band__actions">
      <a class="band__cta" href={pageHref(lang, 'contact')}>{d.band.cta}</a>
      <a class="band__tel" href={SITE.phoneHref}>{SITE.phoneLabel}</a>
    </div>
  </div>
</section>

<style>
  .band {
    font-family: var(--sans);
    background: var(--dark-bg);
    color: var(--dark-soft);
    padding: 72px var(--page-pad);
  }

  .band__grid {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 60px;
    align-items: center;
  }

  .band__kicker {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dark-kicker);
    margin-bottom: 20px;
  }

  .band__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.25;
    margin: 0 0 18px;
    color: var(--dark-ink);
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .band__text {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--dark-text);
    max-width: 40em;
  }

  .band__actions {
    display: grid;
    gap: 14px;
  }

  .band__cta,
  .band__tel {
    padding: 17px 32px;
    font-size: 13.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    transition: background var(--ease), border-color var(--ease);
  }
  .band__cta {
    background: var(--accent);
    color: var(--dark-ink);
  }
  .band__cta:hover {
    background: var(--accent-light);
    color: var(--dark-ink);
  }
  .band__tel {
    border: 1px solid var(--dark-line);
    color: var(--dark-soft);
  }
  .band__tel:hover {
    border-color: var(--dark-kicker);
    color: var(--dark-soft);
  }

  @media (max-width: 900px) {
    .band {
      padding: 56px var(--page-pad);
    }
    .band__grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .band__title {
      font-size: 30px;
    }
  }
</style>
