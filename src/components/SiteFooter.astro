---
import { SITE } from '../data/site';
import { t, pageHref, topicHref, type Locale, type Alternate } from '../i18n';

interface Props {
  lang: Locale;
  alts: Alternate[];
}

const { lang, alts } = Astro.props;
const d = t(lang);

const TOPICS = d.footer.topicLinks.map((label, i) => ({ label, href: topicHref(lang, i) }));

const SITE_LINKS = [
  { label: d.footer.home, href: pageHref(lang, 'home') },
  { label: d.footer.about, href: pageHref(lang, 'about') },
  { label: d.footer.blog, href: pageHref(lang, 'blog') },
  { label: d.footer.contact, href: pageHref(lang, 'contact') },
  { label: d.footer.directions, href: SITE.mapsUrl },
];
---

<footer class="foot">
  <div class="foot__grid">
    <div>
      <div class="foot__name">{d.doctorName}</div>
      <div class="foot__kicker">{d.nav.kicker} · {d.cityLabel}</div>
      <p class="foot__note">{d.footer.note}</p>
      <a class="foot__tel" href={SITE.phoneHref}>{SITE.phoneLabel}</a>
      <address class="foot__addr">
        {SITE.addressLines.join(', ')} ·
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
    </div>

    <nav class="foot__col" aria-label={d.footer.topicsHead}>
      <div class="foot__head">{d.footer.topicsHead}</div>
      {TOPICS.map((x) => <a href={x.href}>{x.label}</a>)}
    </nav>

    <nav class="foot__col" aria-label={d.footer.siteHead}>
      <div class="foot__head">{d.footer.siteHead}</div>
      {SITE_LINKS.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>

    <nav class="foot__col" aria-label={d.footer.langHead}>
      <div class="foot__head">{d.footer.langHead}</div>
      {
        alts.map((a) => (
          <a
            class:list={{ 'foot__lang--on': a.lang === lang }}
            href={a.href}
            hreflang={a.htmlLang}
            lang={a.htmlLang}
          >
            {a.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="foot__bar">
    <span>© {new Date().getFullYear()} {d.doctorName}</span>
    <span>{d.districtLabel}, {d.cityLabel}</span>
  </div>
</footer>

<style>
  .foot {
    font-family: var(--sans);
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .foot__grid {
    padding: 60px var(--page-pad) 34px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 0.9fr;
    gap: 52px;
    color: var(--text-soft);
  }

  .foot__name {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .foot__kicker {
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .foot__note {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.7;
    max-width: 30em;
    color: var(--muted);
  }
  .foot__tel {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--ink);
  }
  .foot__tel:hover { color: var(--accent); }

  .foot__addr {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
    font-style: normal;
  }
  .foot__addr a { color: var(--text-soft); }
  .foot__addr a:hover { color: var(--accent); }

  .foot__col {
    display: grid;
    gap: 11px;
    align-content: start;
    font-size: 14.5px;
  }
  .foot__col a { color: var(--text-soft); }
  .foot__col a:hover { color: var(--accent); }
  .foot__lang--on { color: var(--ink) !important; }

  .foot__head {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fainter);
    margin-bottom: 3px;
  }

  .foot__bar {
    padding: 20px var(--page-pad) 40px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--fainter);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .foot__grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 620px) {
    .foot__grid { grid-template-columns: 1fr; gap: 34px; padding-top: 44px; }
  }
</style>
